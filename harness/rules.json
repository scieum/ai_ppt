  "gates": {
    "G01": {
      "target": "research/",
      "condition": "training objectives and source roles; hashed citations; technical claims verified against official documentation for the declared environment",
      "rollback": "research"
    },
    "G02": {
      "target": "plan.md",
      "condition": "objectives linked to exercises and result checks; slide/break/exercise time totals; full content and source coverage",
      "rollback": "plan"
    },
    "G03": {
      "target": "approvals.json",
      "condition": "human evidence bound to unit and semantic plan hash; simulation forbidden in production",
      "rollback": "plan"
    },
    "G04": {
      "target": "assets/manifest.json",
      "condition": "planned visual and exercise files present, hashed and reviewed; screenshot environment/date; no generated UI evidence",
      "rollback": "image"
    },
    "G05": {
      "target": "drafts/",
      "condition": "PPTX/DOCX sections and sources; speaker/action/wait labels; selected PDF parses with matching page count",
      "rollback": "production"
    },
    "G06": {
      "target": "checks/reviews.json and figma/mapping.json",
      "condition": "current content/learning/visual reviews, full-deck layout/branding, timed rehearsal and criterion evidence; Figma mapping only when selected",
      "rollback": "cause"
    },
    "G07": {
      "target": "protected baseline",
      "condition": "original paths and file hashes unchanged; trusted baseline required",
      "rollback": "stop"
    },
    "G08": {
      "target": "design-review/reference-lock.json and review.json",
      "condition": "seven exact/adopt reference-bound layouts, explicit adoption adjustments and current comparisons; provided branding contract; no unverified criteria",
      "rollback": "prototype"
    },
    "G09": {
      "target": "design-review/approvals.json and feedback.json",
      "condition": "current seven-type reference/candidate human confirmation; no unresolved feedback",
      "rollback": "prototype"
    },
    "G10": {
      "target": "rights/inventory.json, scan.json, review.json, open-issues.json",
      "condition": "Current plan/output/reference/asset bindings; complete rights and distribution coverage; literal-match screening plus human expression/example/visual/asset review; unresolved risks block release. Not a legal certification.",
      "rollback": "plan"
    }
  },
